# Base URL of q-wash-api's /api/v1, e.g. http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Sentry error monitoring. Leave empty to disable (also only ever sent in
# production builds regardless -- see src/main.tsx).
VITE_SENTRY_DSN=

# CARTO Basemaps API key for the point-location map (LocationPicker). Leave
# empty and the map shows "Карта недоступна" instead of tiles. The key ships in
# the browser bundle, so restrict it by domain in the CARTO dashboard.
VITE_CARTO_API_KEY=
